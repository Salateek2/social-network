# Copy this file to ".env" and fill in real values. NEVER commit .env (assignment §7).

# Server
PORT=3000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/socialnetwork
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/socialnetwork
MONGO_URI=mongodb://127.0.0.1:27017/socialnetwork

# Firebase Admin service account key (optional override).
# Default location: server/config/serviceAccountKey.json
# Download from: Firebase console -> Project settings -> Service accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT=./server/config/serviceAccountKey.json
